<IfModule mod_rewrite.c>

    RewriteEngine On

    RewriteBase /NexusCore/public/

    # If the request is NOT an existing file
    RewriteCond %{REQUEST_FILENAME} !-f

    # If the request is NOT an existing directory
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirect everything to index.php
    RewriteRule ^ index.php [QSA,L]

</IfModule>

<IfModule mod_headers.c>

    # Allow Service Worker to control the full /NexusCore/ scope
    <Files "service-worker.js">
        Header set Service-Worker-Allowed "/NexusCore/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>

    # Ensure manifest.json is served with correct MIME and no caching
    <Files "manifest.json">
        Header set Content-Type "application/manifest+json"
        Header set Cache-Control "no-cache"
    </Files>

    # Ensure ping.json is never cached
    <Files "ping.json">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set Access-Control-Allow-Origin "*"
    </Files>

</IfModule>

# Correct MIME types for web fonts
<IfModule mod_mime.c>
    AddType application/manifest+json  .webmanifest
    AddType font/woff2                 .woff2
    AddType font/woff                  .woff
    AddType application/javascript     .js .mjs
</IfModule>


# ----------------------------------------------------------------------
# Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ----------------------------------------------------------------------
# Long-Term Browser Caching for Static Assets (1 Year)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>
